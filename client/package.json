{
  "name": "qyntra-gym-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx vite build",
    "build:native": "cross-env VITE_APP_URL=https://qyntagymweb.vercel.app VITE_API_URL=https://qyntagymweb.vercel.app/api npx vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build:native && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run cap:sync && cd android && .\\gradlew.bat bundleRelease"
  },
  "dependencies": {
